{
  "name": "agent-ctrl",
  "version": "0.0.0",
  "description": "A centralized CLI tool for managing AI agent configurations with standard directory-based patterns.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "agent-ctrl": "./dist/index.js"
  },
  "scripts": {
    "dev": "bun run src/presentation/cli/index.ts",
    "build": "bun build src/presentation/cli/index.ts --outdir dist --target node",
    "start": "node dist/index.js",
    "test": "bun test",
    "lint": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "format": "bash scripts/format.sh",
    "format:check": "bash scripts/format.sh --check"
  },
  "license": "GPL-3.0",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "latest",
    "prettier": "^3.8.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "commander": "^14.0.3"
  }
}
